# Optional server-side keys. Copy to .env.local — never commit secrets.
# Keep any trailing "=" on Blotato keys; wrap values in single quotes.

BLOTATO_API_KEY=
OPENAI_API_KEY=

# Google Drive OAuth (Google Cloud Console → APIs & Services → Credentials)
# Enable Google Drive API. Authorized redirect URI:
#   http://localhost:3000/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Default Drive folder to list/pick media from
GOOGLE_DRIVE_FOLDER_ID=1CcCgh6im2KEfwaYEd5iOcIpt1JbxNh46
